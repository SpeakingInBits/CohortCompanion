@page "/sessions/{Id:guid}/host"
@attribute [Authorize(Roles = Roles.Instructor)]
@rendermode InteractiveServer

@using System.Security.Claims
@using CohortCompanion.Shared
@using CohortCompanion.Shared.Live
@using CohortCompanion.Web.Live

@inject LiveSessionManager Manager
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@(view?.Title ?? "Live session")</PageTitle>

@if (ended)
{
    <h1>Session ended</h1>
    @if (view?.Kind == SessionKind.Presentation)
    {
        <p>Everyone's nicknames have been deleted.</p>
    }
    else
    {
        <p>Per-student data has been deleted. Only the per-question totals were kept.</p>
        <a class="btn btn-primary" href="sessions/@Id/summary">See the totals</a>
    }
    <a class="btn btn-outline-secondary" href="sessions">Back to sessions</a>
}
else if (notFound)
{
    <h1>Session not found</h1>
    <p>It may have ended already. <a href="sessions">Back to sessions</a></p>
}
else if (view is null)
{
    <p><em>Loading…</em></p>
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <h1 class="me-auto mb-0">@view.Title</h1>
        <span class="fs-5">Join code <strong class="font-monospace">@view.JoinCode</strong></span>
        <span class="btn-group">
            <a class="btn btn-outline-secondary" href="@ProjectorLink" target="_blank">Open projector view</a>
            <button type="button" class="btn btn-outline-secondary" title="Copy a link that opens the projector view on any computer, without signing in"
                    @onclick="CopyProjectorLinkAsync">@(copied ? "Copied" : "Copy link")</button>
        </span>
        @if (confirmEnd)
        {
            <button type="button" class="btn btn-danger" @onclick="EndAsync">Confirm end</button>
            <button type="button" class="btn btn-link" @onclick="() => confirmEnd = false">Cancel</button>
        }
        else
        {
            <button type="button" class="btn btn-outline-danger" @onclick="() => confirmEnd = true">End session</button>
        }
    </div>

    @if (Resumed)
    {
        <div class="alert alert-info" role="status">
            This was already running, so you're back in the same session and students keep their join code.
            To start over, end this session, then run it again.
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            @if (view.Status == SessionStatus.Lobby)
            {
                <div class="card">
                    <div class="card-body text-center">
                        <p class="mb-1">Students go to <strong>@NavigationManager.ToAbsoluteUri("join")</strong> or scan:</p>
                        <img class="qr-code d-block mx-auto my-3" src="qr/@(view.JoinCode).svg" alt="QR code to join" />
                        <button type="button" class="btn btn-primary btn-lg" @onclick="() => RunAsync(Manager.StartAsync)">Start</button>
                    </div>
                </div>
            }
            else if (view.Deck is { } deck)
            {
                <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary">Slide @(view.QuestionIndex + 1) of @view.QuestionCount · arrow keys or a clicker work anywhere on this page</span>
                        <span class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary" disabled="@(view.QuestionIndex == 0)" @onclick="() => RunAsync(Manager.PreviousSlideAsync)">Previous</button>
                            <button type="button" class="btn btn-primary" disabled="@(view.QuestionIndex + 1 >= view.QuestionCount)" @onclick="() => RunAsync(Manager.NextSlideAsync)">Next</button>
                        </span>
                    </div>
                    @if (deck.Current is { } slide)
                    {
                        <SlideRenderer Layout="slide.Layout" Content="slide.Content" ThemeId="@deck.ThemeId" />
                    }
                    <div class="row g-3 mt-1">
                        <div class="col-md-5">
                            <h2 class="h6">Next slide</h2>
                            @if (deck.Next is { } next)
                            {
                                <SlideRenderer Layout="next.Layout" Content="next.Content" ThemeId="@deck.ThemeId" />
                            }
                            else
                            {
                                <p class="text-secondary">This is the last slide.</p>
                            }
                        </div>
                        <div class="col-md-7">
                            <h2 class="h6">Speaker notes</h2>
                            <p style="white-space: pre-wrap">@(string.IsNullOrWhiteSpace(deck.SpeakerNotes) ? "No notes for this slide." : deck.SpeakerNotes)</p>
                        </div>
                    </div>
                </div>
            }
            else if (view.Phase == QuestionPhase.Finished)
            {
                <div class="card">
                    <div class="card-body">
                        <h2 class="h4">That's the last question</h2>
                        <p>
                            When you're done showing the final results, end the session. That deletes every nickname
                            and answer, and keeps only the per-question totals.
                        </p>
                        <button type="button" class="btn btn-primary btn-lg" @onclick="EndAsync">End session and keep the totals</button>
                        @if (view.EndsByItselfUtc is { } endsAt)
                        {
                            <p class="form-text mt-2 mb-0">If you don't, it ends by itself in @MinutesUntil(endsAt).</p>
                        }
                    </div>
                </div>
            }
            else if (view.Question is { } question)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                            <span class="text-secondary">Question @(view.QuestionIndex + 1) of @view.QuestionCount · @PhaseName</span>
                            <span>
                                @view.ResponseCount of @view.Participants.Count answered
                                @if (view.RemainingMs is { } remaining && view.Phase is QuestionPhase.Open or QuestionPhase.Waiting)
                                {
                                    <span class="live-timer ms-2" role="timer">@(remaining / 1000)s</span>
                                }
                            </span>
                        </div>

                        <div class="prompt mb-3">@((MarkupString)BlankTokens.ToDisplay(question.Prompt))</div>
                        @if (!string.IsNullOrEmpty(question.CodeSnippet))
                        {
                            <div class="mb-3"><CodeBlock Code="@question.CodeSnippet" Language="@question.CodeLanguage" /></div>
                        }

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (view.IsTimed)
                            {
                                @if (view.Phase == QuestionPhase.Open)
                                {
                                    <button type="button" class="btn btn-outline-primary" @onclick="() => RunAsync(view.IsPaused ? Manager.ResumeTimerAsync : Manager.PauseTimerAsync)">@(view.IsPaused ? "Resume" : "Pause")</button>
                                    <button type="button" class="btn btn-outline-primary" @onclick="() => Manager.ExtendTimerAsync(Id, hostId, 10)">Add 10 seconds</button>
                                }
                                <button type="button" class="btn btn-outline-secondary" @onclick="() => RunAsync(Manager.SkipAsync)">@(view.Phase == QuestionPhase.Waiting ? "Start now" : "Skip")</button>
                            }
                            else
                            {
                            @switch (view.Phase)
                            {
                                case QuestionPhase.Waiting:
                                    <button type="button" class="btn btn-primary" @onclick="() => RunAsync(Manager.OpenQuestionAsync)">Open question</button>
                                    break;
                                case QuestionPhase.Open:
                                    <button type="button" class="btn btn-primary" @onclick="() => RunAsync(Manager.CloseAndShowResultsAsync)">Close and show results</button>
                                    break;
                                case QuestionPhase.Closed:
                                    <button type="button" class="btn btn-primary" @onclick="() => RunAsync(Manager.ShowResultsAsync)">Show results</button>
                                    break;
                                case QuestionPhase.ShowingResults:
                                    @if (question.Type != QuestionType.WordCloud)
                                    {
                                        <button type="button" class="btn btn-primary" @onclick="() => RunAsync(Manager.RevealAnswerAsync)">Reveal answer</button>
                                    }
                                    <button type="button" class="btn @(question.Type == QuestionType.WordCloud ? "btn-primary" : "btn-outline-primary")" @onclick="() => RunAsync(Manager.NextAsync)">@NextLabel</button>
                                    break;
                                case QuestionPhase.AnswerRevealed:
                                    <button type="button" class="btn btn-primary" @onclick="() => RunAsync(Manager.NextAsync)">@NextLabel</button>
                                    break;
                            }
                            <span class="form-text align-self-center ms-1">Space, → or a clicker presses the blue button.</span>
                            }
                        </div>

                        @if (view.LiveResults is { } results)
                        {
                            @if (view.Phase is QuestionPhase.Open or QuestionPhase.Closed)
                            {
                                <h2 class="h6 text-secondary">Only you can see this until you show results</h2>
                            }
                            <ResultsView Results="results" OnHide="HideAsync" OnAccept="AcceptAsync" />
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            @if (view.Leaderboard is { Count: > 0 } leaderboard)
            {
                <h2 class="h5">Top scores</h2>
                <p class="form-text">Rename or remove anyone before the class sees this.</p>
                <ol class="ps-3">
                    @foreach (var entry in leaderboard)
                    {
                        <li>@entry.Nickname: @entry.Score</li>
                    }
                </ol>
            }

            <h2 class="h5">Participants (@view.Participants.Count)</h2>
            @if (view.Participants.Count == 0)
            {
                <p class="text-secondary">Nobody has joined yet.</p>
            }
            <ul class="list-unstyled">
                @foreach (var participant in view.Participants)
                {
                    <li class="d-flex align-items-center gap-2 mb-1" @key="participant.Id">
                        @if (renaming == participant.Id)
                        {
                            <input class="form-control form-control-sm" maxlength="@AnswerLimits.MaxNickname" aria-label="New nickname" @bind="newName" />
                            <button type="button" class="btn btn-sm btn-primary" @onclick="() => RenameAsync(participant.Id)">Save</button>
                        }
                        else
                        {
                            <span class="me-auto text-truncate">@participant.Nickname</span>
                            <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => BeginRename(participant)">Rename</button>
                            <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => Manager.RemoveParticipantAsync(Id, hostId, participant.Id)">Remove</button>
                        }
                    </li>
                }
            </ul>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private HostView? view;
    private string hostId = "";
    private bool notFound;
    private bool ended;
    private bool confirmEnd;
    private Guid? renaming;
    private string? newName;
    private Timer? clock;
    private bool copied;
    private IJSObjectReference? keyListener;
    private DotNetObjectReference<HostSession>? selfReference;

    /// <summary>Set when Run live or Present found this session already running and came back to it.</summary>
    [SupplyParameterFromQuery] public bool Resumed { get; set; }

    private string PhaseName => view?.Phase switch
    {
        QuestionPhase.Waiting => view?.IsTimed == true ? "Starting" : "Not open yet",
        QuestionPhase.Open => "Open",
        QuestionPhase.Closed => "Closed",
        QuestionPhase.ShowingResults => "Showing results",
        QuestionPhase.AnswerRevealed => "Answer revealed",
        _ => "",
    };

    private string NextLabel => view is not null && view.QuestionIndex + 1 >= view.QuestionCount ? "Finish quiz" : "Next question";

    protected override async Task OnInitializedAsync()
    {
        hostId = (await AuthState).User.FindFirstValue(ClaimTypes.NameIdentifier)!;
        await RefreshAsync();
        notFound = view is null;
        if (view is not null)
        {
            Manager.HostViewChanged += OnHostViewChanged;
            clock = new Timer(_ => InvokeAsync(TickClockAsync), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        }
    }

    private void OnHostViewChanged(Guid sessionId)
    {
        if (sessionId == Id)
        {
            _ = InvokeAsync(async () =>
            {
                await RefreshAsync();
                StateHasChanged();
            });
        }
    }

    private async Task TickClockAsync()
    {
        if (view?.RemainingMs is not null || view?.EndsByItselfUtc is not null)
        {
            await RefreshAsync();
            StateHasChanged();
        }
    }

    private async Task RefreshAsync()
    {
        var latest = await Manager.GetHostViewAsync(Id, hostId);
        if (latest is not null)
        {
            view = latest;
        }
        else if (view is not null)
        {
            // It ended without this page asking: it finished long enough ago, or was abandoned.
            ended = true;
        }
    }

    private async Task RunAsync(Func<Guid, string, Task<bool>> command)
    {
        await command(Id, hostId);
        await RefreshAsync();
    }

    /// <summary>
    /// Keys pressed anywhere on the page, unless someone's typing. Presentation clickers send PageDown and PageUp.
    /// Slides go forwards and back. An instructor-paced quiz takes its next step forwards; a timed quiz runs itself,
    /// so a stray key press there does nothing.
    /// </summary>
    [JSInvokable]
    public async Task OnHostKey(string key)
    {
        var forward = key is "ArrowRight" or "PageDown" or " ";
        var back = key is "ArrowLeft" or "PageUp";
        if (view is not { Status: SessionStatus.Running } current || (!forward && !back))
        {
            return;
        }

        var command = current.Kind == SessionKind.Presentation
            ? (forward ? Manager.NextSlideAsync : Manager.PreviousSlideAsync)
            : forward && !current.IsTimed ? NextQuizStep(current) : null;
        if (command is not null)
        {
            await RunAsync(command);
            StateHasChanged();
        }
    }

    /// <summary>The blue button for the quiz's current phase.</summary>
    private Func<Guid, string, Task<bool>>? NextQuizStep(HostView current) => current.Phase switch
    {
        QuestionPhase.Waiting => Manager.OpenQuestionAsync,
        QuestionPhase.Open => Manager.CloseAndShowResultsAsync,
        QuestionPhase.Closed => Manager.ShowResultsAsync,
        QuestionPhase.ShowingResults when current.Question?.Type != QuestionType.WordCloud => Manager.RevealAnswerAsync,
        QuestionPhase.ShowingResults or QuestionPhase.AnswerRevealed => Manager.NextAsync,
        _ => null,
    };

    private string ProjectorLink => $"projector/{Id}?key={Uri.EscapeDataString(view?.ProjectorKey ?? "")}";

    private async Task CopyProjectorLinkAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", NavigationManager.ToAbsoluteUri(ProjectorLink).AbsoluteUri);
        copied = true;
    }

    private static string MinutesUntil(DateTime utc)
    {
        var minutes = (int)Math.Ceiling(Math.Max(0, (utc - DateTime.UtcNow).TotalMinutes));
        return minutes == 1 ? "1 minute" : $"{minutes} minutes";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (keyListener is null && view is not null && !ended)
        {
            selfReference = DotNetObjectReference.Create(this);
            keyListener = await JS.InvokeAsync<IJSObjectReference>("cc.listenForHostKeys", selfReference);
        }
    }

    private Task HideAsync(string word) => Manager.HideWordAsync(Id, hostId, word);

    private Task AcceptAsync((int Blank, string Text) answer) => Manager.AcceptAnswerAsync(Id, hostId, answer.Blank, answer.Text);

    private void BeginRename(ParticipantView participant)
    {
        renaming = participant.Id;
        newName = participant.Nickname;
    }

    private async Task RenameAsync(Guid participantId)
    {
        await Manager.RenameParticipantAsync(Id, hostId, participantId, newName ?? "");
        renaming = null;
    }

    private async Task EndAsync()
    {
        ended = await Manager.EndAsync(Id, hostId);
        confirmEnd = false;
    }

    public async ValueTask DisposeAsync()
    {
        clock?.Dispose();
        Manager.HostViewChanged -= OnHostViewChanged;
        if (keyListener is not null)
        {
            try
            {
                await keyListener.InvokeVoidAsync("dispose");
                await keyListener.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The browser has gone, and the listener with it.
            }
        }

        selfReference?.Dispose();
    }
}
