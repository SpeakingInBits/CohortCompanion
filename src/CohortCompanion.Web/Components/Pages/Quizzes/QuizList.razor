@page "/quizzes"
@attribute [Authorize(Roles = Roles.Instructor + "," + Roles.Admin)]
@rendermode InteractiveServer

@using System.Security.Claims
@using CohortCompanion.Web.Live
@using CohortCompanion.Web.Quizzes

@inject QuizService Quizzes
@inject LiveSessionManager Manager
@inject NavigationManager NavigationManager
@inject AuditLog Audit
@inject TourService Tour

<PageTitle>Quizzes</PageTitle>

<h1>Quizzes</h1>

<form class="row g-2 mb-4" style="max-width: 36rem" @onsubmit="CreateAsync">
    <div class="col">
        <label for="new-title" class="visually-hidden">New quiz title</label>
        <input id="new-title" class="form-control @TourStep.Highlight(TourTarget.NewQuizTitle)" placeholder="New quiz title" maxlength="200" @bind="newTitle" @bind:event="oninput" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(newTitle)">Create quiz</button>
    </div>
</form>

@if (isAdmin)
{
    <div class="form-check mb-3">
        <input id="show-all" class="form-check-input" type="checkbox" checked="@showAll" @onchange="ToggleAllAsync" />
        <label class="form-check-label" for="show-all">Show every instructor's quizzes</label>
    </div>
}

@if (runError is not null)
{
    <div class="alert alert-warning" role="alert">@runError</div>
}

@if (quizzes is null)
{
    <p><em>Loading…</em></p>
}
else if (quizzes.Count == 0)
{
    <p>No quizzes yet. Give your first one a title above.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Pacing</th>
                    <th>Questions</th>
                    @if (showAll)
                    {
                        <th>Owner</th>
                    }
                    <th>Updated</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var quiz in quizzes)
                {
                    <tr>
                        <td>
                            @quiz.Title
                            @if (quiz.IsReady == false)
                            {
                                <a class="badge text-bg-warning ms-1 text-decoration-none" href="quizzes/@quiz.Id/edit" title="Open it to see what to fix before it can run live">Needs fixing</a>
                            }
                        </td>
                        <td>@(quiz.Mode == CohortCompanion.Shared.QuizMode.Timed ? "Timed" : "Instructor-paced")</td>
                        <td>@quiz.QuestionCount</td>
                        @if (showAll)
                        {
                            <td>@quiz.OwnerName</td>
                        }
                        <td><LocalTime Utc="quiz.UpdatedAtUtc" /></td>
                        <td class="text-end text-nowrap">
                            @if (!showAll)
                            {
                                <button type="button" class="btn btn-sm btn-primary @TourStep.Highlight(TourTarget.RunLive, quiz.Id)" disabled="@(quiz.IsReady == false)" @onclick="() => RunAsync(quiz.Id)">Run live</button>
                                <a class="btn btn-sm btn-outline-primary @TourStep.Highlight(TourTarget.EditQuiz, quiz.Id)" href="quizzes/@quiz.Id/edit">Edit</a>
                            }
                            @if (pendingDelete == quiz.Id)
                            {
                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteAsync(quiz.Id)">Confirm delete</button>
                                <button type="button" class="btn btn-sm btn-link" @onclick="() => pendingDelete = null">Cancel</button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => pendingDelete = quiz.Id">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<TourCoach Status="Tour.Status" Step="TourStep" OnChanged="StateHasChanged" />

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    /// <summary>The tour only guides an instructor through their own quizzes, which are the ones they can run.</summary>
    private TourStep? TourStep => Tour.IsActive && !showAll && quizzes is not null ? TourGuide.ForQuizList(quizzes) : null;

    private List<QuizListItem>? quizzes;
    private string userId = "";
    private bool isAdmin;
    private bool showAll;
    private string? newTitle;
    private int? pendingDelete;
    private string? runError;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        userId = user.FindFirstValue(ClaimTypes.NameIdentifier)!;
        isAdmin = user.IsInRole(Roles.Admin);
        await Tour.LoadAsync(userId);
        await LoadAsync();
    }

    private async Task LoadAsync() => quizzes = await Quizzes.ListAsync(userId, isAdmin, everyone: showAll);

    private async Task ToggleAllAsync(ChangeEventArgs e)
    {
        showAll = e.Value is true;
        await LoadAsync();
    }

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(newTitle))
        {
            return;
        }

        var quiz = await Quizzes.CreateAsync(userId, newTitle);
        NavigationManager.NavigateTo($"quizzes/{quiz.Id}/edit");
    }

    private async Task RunAsync(int id)
    {
        runError = null;
        var quiz = await Quizzes.GetAsync(id, userId);
        var (sessionId, resumed) = quiz is null ? (null, false) : await Manager.StartOrResumeQuizAsync(quiz, userId);
        if (sessionId is not { } started)
        {
            runError = "This quiz isn't ready to run yet. Open it to see what needs fixing.";
            return;
        }

        NavigationManager.NavigateTo(LiveSessionManager.HostPath(started, resumed));
    }

    private async Task DeleteAsync(int id)
    {
        var deleted = await Quizzes.DeleteAsync(id, userId, isAdmin);
        if (deleted && showAll)
        {
            Audit.Record(userId, "DeleteQuiz", $"quiz:{id}");
        }

        pendingDelete = null;
        await LoadAsync();
    }
}
