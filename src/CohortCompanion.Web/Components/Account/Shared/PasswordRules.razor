@* What a new password needs, shown up front rather than only after a rejected attempt. *@
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Options
@inject IOptions<IdentityOptions> IdentityOptions

<div class="form-text">@Describe(IdentityOptions.Value.Password)</div>

@code {
    /// <summary>The rules Identity enforces, in words. Built from its settings, so the two can't drift apart.</summary>
    public static string Describe(PasswordOptions rules)
    {
        var needs = new List<string>();
        if (rules.RequireUppercase)
        {
            needs.Add("an uppercase letter");
        }

        if (rules.RequireLowercase)
        {
            needs.Add("a lowercase letter");
        }

        if (rules.RequireDigit)
        {
            needs.Add("a number");
        }

        if (rules.RequireNonAlphanumeric)
        {
            needs.Add("a symbol such as ! or #");
        }

        var length = $"At least {rules.RequiredLength} characters";
        return needs.Count switch
        {
            0 => $"{length}.",
            1 => $"{length}, with {needs[0]}.",
            _ => $"{length}, with {string.Join(", ", needs[..^1])} and {needs[^1]}.",
        };
    }
}
