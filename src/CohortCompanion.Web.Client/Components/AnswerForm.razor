@* The student's input for one question. It only collects the answer; the server decides if it counts. *@

@switch (Question.Type)
{
    case QuestionType.MultipleChoice:
        @if (Question.AllowMultipleSelect)
        {
            <p class="answer-hint">Select all that apply.</p>
        }
        <div class="option-list">
            @for (var i = 0; i < Question.Options.Count; i++)
            {
                var option = Question.Options[i];
                var isSelected = selected.Contains(option.Index);
                <button type="button" class="option-choice opt-@(i % 4) @(isSelected ? "is-selected" : "")" style="--i: @i"
                        aria-pressed="@(isSelected ? "true" : "false")"
                        @onclick="() => Toggle(option.Index)">
                    <span class="option-letter" aria-hidden="true">@((char)('A' + i % 26))</span>
                    <span class="option-text">@option.Text</span>
                    <svg class="option-check" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>
                </button>
            }
        </div>
        break;

    case QuestionType.WordCloud:
        @for (var i = 0; i < entries.Length; i++)
        {
            var index = i;
            <input class="form-control form-control-lg mb-2" maxlength="@AnswerLimits.MaxEntryLength" aria-label="Word @(index + 1)" placeholder="Your word"
                   enterkeyhint="done" value="@entries[index]" @oninput="e => entries[index] = e.Value?.ToString() ?? string.Empty" />
        }
        break;

    case QuestionType.FillInBlank:
        @for (var i = 0; i < blanks.Length; i++)
        {
            var index = i;
            <label class="form-label" for="blank-@index">Blank @(index + 1)</label>
            <input id="blank-@index" class="form-control form-control-lg mb-2" maxlength="@AnswerLimits.MaxBlankLength" autocomplete="off" autocapitalize="off"
                   enterkeyhint="done" value="@blanks[index]" @oninput="e => blanks[index] = e.Value?.ToString() ?? string.Empty" />
        }
        break;
}

<div class="answer-submit">
    <button type="button" class="btn btn-primary btn-lg w-100" disabled="@(Busy || !HasAnswer)" @onclick="SubmitAsync">
        @if (Busy)
        {
            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
        }
        Submit
    </button>
</div>

@code {
    [Parameter, EditorRequired] public StudentQuestion Question { get; set; } = default!;

    [Parameter] public EventCallback<AnswerPayload> OnSubmit { get; set; }

    [Parameter] public bool Busy { get; set; }

    private readonly HashSet<int> selected = [];
    private string[] entries = [];
    private string[] blanks = [];
    private int questionId;

    protected override void OnParametersSet()
    {
        if (questionId == Question.Id)
        {
            return;
        }

        questionId = Question.Id;
        selected.Clear();
        entries = new string[Math.Max(1, Question.MaxEntries)];
        blanks = new string[Question.BlankCount];
        Array.Fill(entries, "");
        Array.Fill(blanks, "");
    }

    private bool HasAnswer => Question.Type switch
    {
        QuestionType.MultipleChoice => selected.Count > 0,
        // Typing updates these without re-rendering, so text inputs always leave the button enabled.
        _ => true,
    };

    private void Toggle(int index)
    {
        if (!Question.AllowMultipleSelect)
        {
            selected.Clear();
            selected.Add(index);
        }
        else if (!selected.Remove(index))
        {
            selected.Add(index);
        }
    }

    private Task SubmitAsync() => OnSubmit.InvokeAsync(Question.Type switch
    {
        QuestionType.MultipleChoice => new AnswerPayload(Options: selected.ToArray()),
        QuestionType.WordCloud => new AnswerPayload(Entries: entries.Where(e => !string.IsNullOrWhiteSpace(e)).ToArray()),
        _ => new AnswerPayload(Blanks: blanks),
    });
}
