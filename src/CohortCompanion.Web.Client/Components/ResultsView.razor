@* Totals for one question. Used by the host page, the projector, and student devices. *@

@if (Results.Options is { } options)
{
    var total = Math.Max(1, Results.ResponseCount);
    var position = 0;
    @foreach (var option in options)
    {
        <div class="result-row @(option.IsCorrect == true ? "is-correct" : option.IsCorrect == false ? "is-wrong" : "")" style="--i: @(position++)">
            <div class="result-bar"><div style="width: @(option.Count * 100 / total)%"></div></div>
            <div class="result-main">
                <span>
                    @if (option.IsCorrect == true)
                    {
                        <span class="result-tick" aria-label="Correct answer">✓ </span>
                    }
                    @option.Text
                </span>
                <span class="result-count">@option.Count</span>
            </div>
        </div>
    }
}
else if (Results.Words is { } words)
{
    @if (words.Count == 0)
    {
        <p class="text-secondary">No words yet.</p>
    }
    else
    {
        var largest = words.Max(w => w.Count);
        var position = 0;
        <div class="word-cloud">
            @foreach (var word in words)
            {
                <span class="word word-@(position++ % 5)" style="font-size: @(FontSize(word.Count, largest))em" @key="word.Word">
                    @word.Word
                    @if (OnHide.HasDelegate)
                    {
                        <button type="button" class="btn btn-sm btn-link p-0 ms-1" aria-label="Hide @word.Word" @onclick="() => OnHide.InvokeAsync(word.Word)">✕</button>
                    }
                </span>
            }
        </div>
    }
}
else if (Results.Blanks is { } blanks)
{
    @foreach (var blank in blanks)
    {
        var total = Math.Max(1, blank.Answers.Sum(a => a.Count));
        var position = 0;
        <h3 class="h6 mt-3">Blank @blank.Blank</h3>
        @if (blank.Answers.Count == 0)
        {
            <p class="text-secondary">No answers.</p>
        }
        @foreach (var answer in blank.Answers)
        {
            <div class="result-row @(answer.IsAccepted == true ? "is-correct" : "")" style="--i: @(position++)">
                <div class="result-bar"><div style="width: @(answer.Count * 100 / total)%"></div></div>
                <div class="result-main">
                    <span>
                        @if (answer.IsAccepted == true)
                        {
                            <span class="result-tick" aria-label="Accepted answer">✓ </span>
                        }
                        @answer.Text
                    </span>
                    <span class="result-count">
                        @if (OnHide.HasDelegate)
                        {
                            <button type="button" class="btn btn-sm btn-link p-0 me-2" @onclick="() => OnHide.InvokeAsync(answer.Text)">Hide</button>
                        }
                        @if (OnAccept.HasDelegate && answer.IsAccepted != true)
                        {
                            <button type="button" class="btn btn-sm btn-link p-0 me-2" @onclick="() => OnAccept.InvokeAsync((blank.Blank, answer.Text))">Accept</button>
                        }
                        @answer.Count
                    </span>
                </div>
            </div>
        }
    }
}

@code {
    [Parameter, EditorRequired] public QuestionResults Results { get; set; } = default!;

    /// <summary>Set on the host page, to hide a word or an answer from the class.</summary>
    [Parameter] public EventCallback<string> OnHide { get; set; }

    /// <summary>Set on the host page, to mark a common answer as accepted.</summary>
    [Parameter] public EventCallback<(int Blank, string Text)> OnAccept { get; set; }

    private static string FontSize(int count, int largest) =>
        (1 + 2.2 * count / largest).ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
}
