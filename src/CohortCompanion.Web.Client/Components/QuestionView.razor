@* The prompt, image, and code of a question, as students and the projector see it. *@

<div class="prompt mb-3">@((MarkupString)Question.Prompt)</div>

@if (!string.IsNullOrEmpty(Question.ImageUrl))
{
    <img src="@Question.ImageUrl" alt="" class="img-fluid rounded mb-3" />
}

@if (!string.IsNullOrEmpty(Question.CodeSnippet))
{
    <div class="mb-3"><CodeBlock Code="@Question.CodeSnippet" Language="@Question.CodeLanguage" /></div>
}

@code {
    [Parameter, EditorRequired] public StudentQuestion Question { get; set; } = default!;
}
