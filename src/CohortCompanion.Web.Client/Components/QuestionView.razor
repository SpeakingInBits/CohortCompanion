@* The prompt and image of a question, as students and the projector see it. *@

<div class="prompt">@((MarkupString)Question.Prompt)</div>

@if (!string.IsNullOrEmpty(Question.ImageUrl))
{
    <img src="@Question.ImageUrl" alt="" class="question-image" />
}

@code {
    [Parameter, EditorRequired] public StudentQuestion Question { get; set; } = default!;
}
