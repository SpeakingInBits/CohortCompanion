@page "/projector/{SessionId:guid}"
@layout LiveLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using CohortCompanion.Web.Client.Live
@using Microsoft.AspNetCore.SignalR.Client

@implements IAsyncDisposable
@inject NavigationManager Navigation

<main class="live-shell projector" data-bs-theme="dark">
    @if (message is not null)
    {
        <div class="live-center">
            <h1>@message</h1>
        </div>
    }
    else if (view is null)
    {
        <div class="live-center">
            <div class="live-pulse"><BrandMark /></div>
            <p role="status">Connecting…</p>
        </div>
    }
    else if (view.Phase.Status == SessionStatus.Lobby)
    {
        <div class="projector-lobby">
            <div class="projector-lobby-join">
                <h1>@view.Title</h1>
                <p>Go to <strong>@JoinHost/join</strong> and enter</p>
                <div class="join-code">@view.JoinCode</div>
            </div>
            <div class="qr-frame">
                <img class="qr-code" src="qr/@(view.JoinCode).svg" alt="QR code to join" />
            </div>
        </div>
        <p class="projector-count"><strong @key="view.ParticipantCount">@view.ParticipantCount</strong> joined</p>
        <div class="nickname-chips">
            @foreach (var name in view.Nicknames)
            {
                <span class="nickname-chip" @key="name"><Avatar Name="@name" /> @name</span>
            }
        </div>
    }
    else if (view.Slide is { } slide)
    {
        <div class="projector-slide">
            <div class="projector-slide-frame" @key="slide.Index">
                <SlideRenderer Layout="slide.Layout" Content="slide.Content" ThemeId="@(view.ThemeId ?? SlideThemes.DefaultTheme)" />
            </div>
            <span class="projector-join">Join: <strong>@view.JoinCode</strong></span>
        </div>
    }
    else if (view.Phase.Phase == QuestionPhase.Finished)
    {
        <h1 class="projector-finish">That's the end of the quiz</h1>
        @if (view.Leaderboard is { Count: > 0 } podium)
        {
            <LeaderboardView Entries="podium" Podium="true" />
        }
    }
    else if (view.Phase.Question is { } question)
    {
        @if (view.Phase.Phase == QuestionPhase.Open && RemainingSeconds is { } secondsLeft)
        {
            <TimerBar Fraction="TimerFraction" Urgent="@(secondsLeft <= UrgentSeconds)" Paused="view.Phase.IsPaused" />
        }

        <div class="projector-header">
            <span class="question-count">Question @(view.Phase.QuestionIndex + 1) of @view.Phase.QuestionCount</span>
            <span class="d-flex align-items-center gap-4">
                @if (view.Phase.Phase == QuestionPhase.Open)
                {
                    <span>@view.ResponseCount of @view.ParticipantCount answered</span>
                    @if (RemainingSeconds is { } seconds)
                    {
                        <span class="live-pill live-timer @(seconds <= UrgentSeconds && !view.Phase.IsPaused ? "is-urgent" : "")" role="timer">@(view.Phase.IsPaused ? "Paused" : $"{seconds}s")</span>
                    }
                }
                else if (view.Phase.Phase == QuestionPhase.Waiting && RemainingSeconds is { } startsIn)
                {
                    <span class="live-pill live-timer" role="timer">Starts in @Math.Max(1, startsIn)s</span>
                }
                <span>Join: <strong>@view.JoinCode</strong></span>
            </span>
        </div>

        <div class="question-screen" @key="question.Id">
            <QuestionView Question="question" />

            @if (view.Phase.Results is { } results)
            {
                <div class="projector-results">
                    <div><ResultsView Results="results" /></div>
                    @if (view.Leaderboard is { Count: > 0 } leaderboard)
                    {
                        <div><LeaderboardView Entries="leaderboard" /></div>
                    }
                </div>
            }
            else if (question.Options.Count > 0)
            {
                <ol class="projector-options">
                    @for (var i = 0; i < question.Options.Count; i++)
                    {
                        <li class="opt-@(i % 4)" style="--i: @i">
                            <span class="option-letter" aria-hidden="true">@((char)('A' + i % 26))</span>
                            @question.Options[i].Text
                        </li>
                    }
                </ol>
            }
        </div>
    }
</main>

@code {
    private const int UrgentSeconds = 5;

    [Parameter] public Guid SessionId { get; set; }

    private HubConnection? hub;
    private ProjectorState? view;
    private string? message;
    private DateTime? deadlineUtc;
    private int timerTotalMs;
    private Timer? countdown;

    private string JoinHost => new Uri(Navigation.BaseUri).Authority;

    private int? RemainingSeconds => view?.Phase.IsPaused == true
        ? (view.Phase.RemainingMs ?? 0) / 1000
        : deadlineUtc is { } deadline ? (int)Math.Ceiling(Math.Max(0, (deadline - DateTime.UtcNow).TotalSeconds)) : null;

    private double TimerFraction
    {
        get
        {
            var remainingMs = view?.Phase.IsPaused == true
                ? view.Phase.RemainingMs ?? 0
                : deadlineUtc is { } deadline ? (deadline - DateTime.UtcNow).TotalMilliseconds : 0;
            return timerTotalMs > 0 ? remainingMs / timerTotalMs : 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri(HubEvents.HubPath))
            .WithAutomaticReconnect(new ForeverRetryPolicy())
            .Build();

        hub.On<ProjectorState>(HubEvents.ProjectorUpdated, update => InvokeAsync(() => Apply(update)));
        hub.On<object?>(HubEvents.SessionEnded, _ => InvokeAsync(() =>
        {
            message = "This session has ended";
            StateHasChanged();
        }));
        hub.Reconnected += _ => InvokeAsync(WatchAsync);

        countdown = new Timer(_ => InvokeAsync(() =>
        {
            if (deadlineUtc is not null)
            {
                StateHasChanged();
            }
        }), null, TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));

        try
        {
            await hub.StartAsync();
            await WatchAsync();
        }
        catch (Exception)
        {
            message = "Couldn't connect. Sign in as the instructor running this session, then reload.";
        }
    }

    private async Task WatchAsync()
    {
        var state = await hub!.InvokeAsync<ProjectorState?>("WatchProjector", SessionId);
        if (state is null)
        {
            message = "This session isn't running.";
            StateHasChanged();
            return;
        }

        Apply(state);
    }

    private void Apply(ProjectorState state)
    {
        // The full length of the timer isn't sent, so the longest time seen for this open question stands in for it.
        var sameTimer = view?.Phase.Phase == QuestionPhase.Open && state.Phase.Phase == QuestionPhase.Open
            && view.Phase.Question?.Id == state.Phase.Question?.Id;
        timerTotalMs = Math.Max(sameTimer ? timerTotalMs : 0, state.Phase.RemainingMs ?? 0);

        view = state;
        deadlineUtc = state.Phase.Phase is QuestionPhase.Open or QuestionPhase.Waiting && state.Phase.RemainingMs is { } ms ? DateTime.UtcNow.AddMilliseconds(ms) : null;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        countdown?.Dispose();
        if (hub is not null)
        {
            await hub.DisposeAsync();
        }
    }
}
