@page "/join"
@page "/j/{Code}"
@layout LiveLayout
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using CohortCompanion.Web.Client.Live
@using Microsoft.AspNetCore.SignalR.Client

@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject IJSRuntime JS

<main class="live-shell @(IsWatchingSlides ? "live-shell-stage" : "")" data-bs-theme="dark">
    @if (screen == Screen.Connecting)
    {
        <div class="live-center">
            <div class="live-pulse"><BrandMark /></div>
            <p role="status">Connecting…</p>
        </div>
    }
    else if (screen == Screen.Form)
    {
        <div class="join-panel">
            <div class="join-brand"><BrandMark /> CohortCompanion</div>
            <h1>Join a session</h1>
            <form @onsubmit="JoinAsync">
                <div class="mb-3">
                    <label for="code" class="form-label">Join code</label>
                    <input id="code" class="form-control form-control-lg code-input" inputmode="numeric" maxlength="6" autocomplete="off"
                           enterkeyhint="next" @bind="joinCode" @bind:event="oninput" />
                </div>
                <div class="mb-3">
                    <label for="nickname" class="form-label">Nickname</label>
                    <input id="nickname" class="form-control form-control-lg" maxlength="@AnswerLimits.MaxNickname" autocomplete="off"
                           enterkeyhint="go" @bind="nickname" @bind:event="oninput" />
                    <div class="form-text">Use a nickname. Don't enter your full name or student ID.</div>
                </div>
                @if (error is not null)
                {
                    <div class="alert alert-danger" role="alert">@error</div>
                }
                <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@busy">
                    @if (busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                    }
                    Join
                </button>
            </form>
            <p class="join-privacy"><a href="privacy" target="_blank">What we collect and how long we keep it</a></p>
        </div>
    }
    else if (screen == Screen.Removed)
    {
        <div class="live-center">
            <h1>You've been removed from this session</h1>
        </div>
    }
    else if (screen == Screen.Ended)
    {
        <div class="live-center">
            <div class="done-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
            <h1>This session has ended</h1>
            <p>Thanks for taking part. Your answers have been deleted.</p>
        </div>
    }
    else if (state is not null && phase is not null)
    {
        @if (phase.Phase == QuestionPhase.Open && RemainingSeconds is { } secondsLeft)
        {
            <TimerBar Fraction="TimerFraction" Urgent="@(secondsLeft <= UrgentSeconds)" Paused="phase.IsPaused" />
        }

        <header class="live-bar">
            <Avatar Name="@state.Nickname" />
            <div class="live-bar-text">
                <strong>@state.Nickname</strong>
                <span>@state.Title</span>
            </div>
            @if (connectionLost)
            {
                <button type="button" class="live-pill is-danger" role="alert" @onclick="() => Navigation.Refresh(forceReload: true)">Connection lost. Reload this page.</button>
            }
            else if (reconnecting)
            {
                <span class="live-pill is-warning" role="status"><i class="spin-dot"></i> Reconnecting…</span>
            }
            else if (phase.Phase == QuestionPhase.Open && RemainingSeconds is { } seconds)
            {
                <span class="live-pill live-timer @(seconds <= UrgentSeconds && !phase.IsPaused ? "is-urgent" : "")" role="timer">@(phase.IsPaused ? "Paused" : $"{seconds}s")</span>
            }
            else if (phase.Status == SessionStatus.Running && phase.Phase != QuestionPhase.Finished)
            {
                <span class="live-pill is-live"><i class="live-dot"></i> Live</span>
            }
        </header>

        @if (phase.Status == SessionStatus.Lobby)
        {
            <div class="live-center">
                <div class="live-pulse"><Avatar Name="@state.Nickname" Class="avatar-xl" /></div>
                <h1>@state.Title</h1>
                <p>You're in. Waiting for the instructor to start.</p>
            </div>
        }
        else if (state.Kind == SessionKind.Presentation)
        {
            <PresentationView ThemeId="@themeId" LiveIndex="liveIndex" SlideCount="@(state.Presentation?.SlideCount ?? phase.QuestionCount)" Slides="shownSlides" />
        }
        else if (phase.Phase == QuestionPhase.Finished)
        {
            <div class="live-center">
                <h1>That's the end of the quiz</h1>
                @if (standing is not null)
                {
                    <StandingView Standing="standing" Final="true" />
                }
            </div>
        }
        else if (phase.Question is null)
        {
            <div class="live-center">
                <div class="live-pulse"><BrandMark /></div>
                <p>Get ready for question @(phase.QuestionIndex + 1) of @phase.QuestionCount.</p>
            </div>
        }
        else
        {
            <div class="question-screen" @key="phase.Question.Id">
                <p class="question-count">Question @(phase.QuestionIndex + 1) of @phase.QuestionCount</p>
                <QuestionView Question="phase.Question" />

                @if (phase.Results is not null)
                {
                    @if (phase.Phase == QuestionPhase.AnswerRevealed && standing is not null)
                    {
                        <StandingView Standing="standing" />
                    }
                    <ResultsView Results="phase.Results" />
                }
                else if (phase.Phase == QuestionPhase.Open && !answered)
                {
                    <AnswerForm Question="phase.Question" Busy="busy" OnSubmit="SubmitAsync" />
                    @if (error is not null)
                    {
                        <div class="alert alert-danger mt-2" role="alert">@error</div>
                    }
                }
                else if (answered)
                {
                    <div class="answer-note" role="status">
                        <div class="done-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
                        Answer received. Waiting for the results.
                    </div>
                }
                else
                {
                    <div class="answer-note" role="status">This question is closed.</div>
                }
            </div>
        }
    }
</main>

@code {
    private const string TokenKey = "cc.participant";
    private const int MaxRejoinAttempts = 6;
    private const int UrgentSeconds = 5;

    private enum Screen { Connecting, Form, Live, Removed, Ended }

    [Parameter] public string? Code { get; set; }

    private Screen screen = Screen.Connecting;
    private HubConnection? hub;
    private StudentSessionState? state;
    private PhaseUpdate? phase;
    private Standing? standing;
    private readonly SortedDictionary<int, SlideView> shownSlides = [];
    private string themeId = SlideThemes.DefaultTheme;
    private int liveIndex;
    private string? token;
    private string? joinCode;
    private string? nickname;
    private string? error;
    private bool busy;
    private bool answered;
    private bool reconnecting;
    private bool connectionLost;
    private DateTime? deadlineUtc;
    private int timerTotalMs;
    private Timer? countdown;
    private bool keepingScreenOn;

    private bool IsWatchingSlides => screen == Screen.Live
        && state?.Kind == SessionKind.Presentation
        && phase?.Status != SessionStatus.Lobby;

    private int? RemainingSeconds => phase?.IsPaused == true
        ? (phase.RemainingMs ?? 0) / 1000
        : deadlineUtc is { } deadline ? (int)Math.Ceiling(Math.Max(0, (deadline - DateTime.UtcNow).TotalSeconds)) : null;

    private double TimerFraction
    {
        get
        {
            var remainingMs = phase?.IsPaused == true
                ? phase.RemainingMs ?? 0
                : deadlineUtc is { } deadline ? (deadline - DateTime.UtcNow).TotalMilliseconds : 0;
            return timerTotalMs > 0 ? remainingMs / timerTotalMs : 0;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        joinCode = Code;

        hub = new HubConnectionBuilder()
            .WithUrl(Navigation.ToAbsoluteUri(HubEvents.HubPath))
            .WithAutomaticReconnect(new ForeverRetryPolicy())
            .Build();

        hub.On<PhaseUpdate>(HubEvents.PhaseChanged, update => InvokeAsync(() => ApplyPhase(update)));
        hub.On<QuestionResults>(HubEvents.ResultsUpdated, results => InvokeAsync(() =>
        {
            phase = phase is null ? null : phase with { Results = results };
            StateHasChanged();
        }));
        hub.On<SlideUpdate>(HubEvents.SlideChanged, update => InvokeAsync(() =>
        {
            shownSlides[update.Slide.Index] = update.Slide;
            liveIndex = update.LiveIndex;
            StateHasChanged();
        }));
        hub.On<Standing?>(HubEvents.LeaderboardUpdated, update => InvokeAsync(() =>
        {
            standing = update;
            StateHasChanged();
        }));
        hub.On<string>(HubEvents.NicknameChanged, name => InvokeAsync(() =>
        {
            state = state is null ? null : state with { Nickname = name };
            StateHasChanged();
        }));
        hub.On<object?>(HubEvents.ParticipantRemoved, _ => InvokeAsync(() => LeaveAsync(Screen.Removed)));
        hub.On<object?>(HubEvents.SessionEnded, _ => InvokeAsync(() => LeaveAsync(Screen.Ended)));

        hub.Reconnecting += _ => InvokeAsync(() =>
        {
            reconnecting = true;
            StateHasChanged();
        });
        hub.Reconnected += _ => InvokeAsync(RejoinAsync);

        countdown = new Timer(_ => InvokeAsync(() =>
        {
            if (deadlineUtc is not null && phase?.Phase == QuestionPhase.Open)
            {
                StateHasChanged();
            }
        }), null, TimeSpan.FromMilliseconds(500), TimeSpan.FromMilliseconds(500));

        try
        {
            await hub.StartAsync();
        }
        catch (Exception)
        {
            error = "Couldn't reach the server. Check your connection and reload the page.";
            screen = Screen.Form;
            return;
        }

        token = await ReadTokenAsync();
        if (token is not null)
        {
            await RejoinAsync();
        }
        else
        {
            screen = Screen.Form;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var wanted = screen == Screen.Live;
        if (wanted != keepingScreenOn)
        {
            keepingScreenOn = wanted;
            await JS.InvokeVoidAsync("cc.keepScreenOn", wanted);
        }
    }

    private async Task JoinAsync()
    {
        if (hub is null || busy)
        {
            return;
        }

        busy = true;
        error = null;
        try
        {
            var result = await hub.InvokeAsync<JoinResult>("Join", joinCode ?? "", nickname ?? "");
            if (result.Error != JoinError.None)
            {
                error = result.Error switch
                {
                    JoinError.SessionNotFound => "There's no live session with that code. Check the code and try again.",
                    JoinError.NicknameInvalid => $"Nicknames must be {AnswerLimits.MinNickname} to {AnswerLimits.MaxNickname} characters.",
                    JoinError.NicknameNotAllowed => "Please choose a different nickname.",
                    _ => "That nickname is taken. Please choose another.",
                };
                return;
            }

            token = result.ParticipantToken;
            await WriteTokenAsync(token);
            ApplyState(result.State!);
        }
        catch (Exception)
        {
            error = "Couldn't join. Check your connection and try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task RejoinAsync()
    {
        reconnecting = false;
        if (hub is null || token is null)
        {
            StateHasChanged();
            return;
        }

        // A connection that isn't rejoined looks fine but receives nothing, so this can't fail quietly. The random
        // wait spreads a whole class out, instead of everyone retrying in the same instant.
        for (var attempt = 1; attempt <= MaxRejoinAttempts; attempt++)
        {
            try
            {
                var restored = await hub.InvokeAsync<StudentSessionState?>("Rejoin", token);
                if (restored is not null)
                {
                    ApplyState(restored);
                }
                else
                {
                    await ClearTokenAsync();
                    screen = state is null ? Screen.Form : Screen.Ended;
                }

                connectionLost = false;
                reconnecting = false;
                StateHasChanged();
                return;
            }
            catch (Exception) when (attempt < MaxRejoinAttempts)
            {
                reconnecting = true;
                StateHasChanged();
                await Task.Delay(TimeSpan.FromSeconds(attempt + (Random.Shared.NextDouble() * 3)));
            }
            catch (Exception)
            {
                reconnecting = false;
                connectionLost = state is not null;
                screen = state is null ? Screen.Form : screen;
            }
        }

        StateHasChanged();
    }

    private void ApplyState(StudentSessionState restored)
    {
        state = restored;
        standing = restored.MyStanding;
        if (restored.Presentation is { } presentation)
        {
            themeId = presentation.ThemeId;
            liveIndex = presentation.LiveIndex;
            shownSlides.Clear();
            foreach (var slide in presentation.ShownSlides)
            {
                shownSlides[slide.Index] = slide;
            }
        }

        answered = restored.MyAnswer is not null;
        screen = Screen.Live;
        SetPhase(restored.Phase);
    }

    private void ApplyPhase(PhaseUpdate update)
    {
        if (update.Question?.Id != phase?.Question?.Id && update.Question is not null)
        {
            answered = false;
        }

        error = null;
        SetPhase(update);
        StateHasChanged();
    }

    private void SetPhase(PhaseUpdate update)
    {
        // The full length of the timer isn't sent, so the longest time seen for this open question stands in for it.
        var sameTimer = phase?.Phase == QuestionPhase.Open && update.Phase == QuestionPhase.Open && phase.Question?.Id == update.Question?.Id;
        timerTotalMs = Math.Max(sameTimer ? timerTotalMs : 0, update.RemainingMs ?? 0);

        phase = update;
        deadlineUtc = update.RemainingMs is { } ms ? DateTime.UtcNow.AddMilliseconds(ms) : null;
    }

    private async Task SubmitAsync(AnswerPayload answer)
    {
        if (hub is null || phase?.Question is not { } question)
        {
            return;
        }

        busy = true;
        error = null;
        try
        {
            var result = await hub.InvokeAsync<SubmitResult>("SubmitAnswer", question.Id, answer);
            if (result.Accepted || result.Reason == "already-answered")
            {
                answered = true;
            }
            else
            {
                error = result.Reason switch
                {
                    "closed" => "Too late: this question has closed.",
                    "invalid" => "Please complete your answer first.",
                    _ => "Your answer couldn't be sent. Try again.",
                };
            }
        }
        catch (Exception)
        {
            error = "Your answer couldn't be sent. Try again.";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LeaveAsync(Screen next)
    {
        await ClearTokenAsync();
        screen = next;
        StateHasChanged();
    }

    // The token is the only thing stored on the device. It's saved with its join code, so opening a link for
    // a different session starts fresh. Storage can be blocked, for example in private browsing; the session
    // then works but won't survive a reload.
    private async Task<string?> ReadTokenAsync()
    {
        try
        {
            var stored = await JS.InvokeAsync<string?>("localStorage.getItem", TokenKey);
            var parts = stored?.Split('|');
            return parts is { Length: 2 } && (string.IsNullOrEmpty(Code) || Code == parts[0]) ? parts[1] : null;
        }
        catch (JSException)
        {
            return null;
        }
    }

    private async Task WriteTokenAsync(string? value)
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", TokenKey, $"{joinCode?.Trim()}|{value}");
        }
        catch (JSException)
        {
        }
    }

    private async Task ClearTokenAsync()
    {
        token = null;
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", TokenKey);
        }
        catch (JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        countdown?.Dispose();
        if (hub is not null)
        {
            await hub.DisposeAsync();
        }
    }
}
